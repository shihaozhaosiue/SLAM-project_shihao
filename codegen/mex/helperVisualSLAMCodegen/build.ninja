# CompilerName=msvcpp170
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root\build\win64
matlabdir = C:\Program Files\MATLAB\R2024b
startdir = C:\Shihao_research\Robotic Vision-ME-462-001-202515\SLAM project_shihao

# Toolchain information
cc = cl
cxx = cl
linker = link
linkerxx = link

cflags =  /c /Zc:__cplusplus /Zp8 /GR /W3 /EHs /nologo /MD /D_CRT_SECURE_NO_DEPRECATE /D_SCL_SECURE_NO_DEPRECATE /D_SECURE_SCL=0   /DMATLAB_MEX_FILE  /DMATLAB_MEX_FILE /O2 /Oy- /DNDEBUG /fp:strict /utf-8 /I "$root" /I "$startdir" /I "$matlabdir\toolbox\vision\builtins\src\ocv\include" /I "$matlabdir\toolbox\images\opencv\opencvcg\include" /I "$matlabdir\extern\include" /I "$matlabdir\toolbox\vision\builtins\src\vision\include" /I "$matlabdir\toolbox\vision\builtins\src\vision\include\calibration" /I "$matlabdir\toolbox\vision\builtins\src\vision\export\include\vision" /I "$matlabdir\toolbox\vision\builtins\src\vision\export\include\vision\calibration" /I "$root\interface" /I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=helperVisualSLAMCodegen_mex -DMW_NEEDS_VERSION_H /openmp /wd4101 /wd4251 

cxxflags =  /c /Zc:__cplusplus /Zp8 /GR /W3 /EHs /nologo /MD /D_CRT_SECURE_NO_DEPRECATE /D_SCL_SECURE_NO_DEPRECATE /D_SECURE_SCL=0   /DMATLAB_MEX_FILE  /DMATLAB_MEX_FILE /O2 /Oy- /DNDEBUG /fp:strict /utf-8 /I "$root" /I "$startdir" /I "$matlabdir\toolbox\vision\builtins\src\ocv\include" /I "$matlabdir\toolbox\images\opencv\opencvcg\include" /I "$matlabdir\extern\include" /I "$matlabdir\toolbox\vision\builtins\src\vision\include" /I "$matlabdir\toolbox\vision\builtins\src\vision\include\calibration" /I "$matlabdir\toolbox\vision\builtins\src\vision\export\include\vision" /I "$matlabdir\toolbox\vision\builtins\src\vision\export\include\vision\calibration" /I "$root\interface" /I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=helperVisualSLAMCodegen_mex -DMW_NEEDS_VERSION_H /openmp /wd4101 /wd4251 

ldflags =  /nologo    /DLL /LIBPATH:"$matlabdir\extern\lib\win64\microsoft" libmx.lib libmex.lib libmat.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib  /out:"helperVisualSLAMCodegen_mex.mexw64" /LIBPATH:"$matlabdir\extern\lib\win64\microsoft" libmwblas.lib libmwlapack.lib libemlrt.lib libcovrt.lib libut.lib libmwmathutil.lib libiomp5md.lib /nodefaultlib:vcomp /LIBPATH:"$matlabdir\bin\win64"

ldxxflags =  /nologo    /DLL /LIBPATH:"$matlabdir\extern\lib\win64\microsoft" libmx.lib libmex.lib libmat.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib libMatlabDataArray.lib libMatlabEngine.lib  /out:"helperVisualSLAMCodegen_mex.mexw64" /LIBPATH:"$matlabdir\extern\lib\win64\microsoft" libmwblas.lib libmwlapack.lib libemlrt.lib libcovrt.lib libut.lib libmwmathutil.lib libiomp5md.lib /nodefaultlib:vcomp /LIBPATH:"$matlabdir\bin\win64"

linkobjs =  "$matlabdir\toolbox\images\opencv\opencvcg\win64\lib\opencv_core470.lib" "$matlabdir\toolbox\images\opencv\opencvcg\win64\lib\opencv_imgproc470.lib" "$matlabdir\toolbox\images\opencv\opencvcg\win64\lib\opencv_features2d470.lib" "$matlabdir\toolbox\images\opencv\opencvcg\win64\lib\opencv_flann470.lib" "$matlabdir\extern\lib\win64\microsoft\libmwComputeMetric.lib" "$matlabdir\extern\lib\win64\microsoft\libmwbundleAdjust.lib" "$matlabdir\toolbox\images\opencv\opencvcg\win64\lib\opencv_calib3d470.lib" "$matlabdir\toolbox\images\opencv\opencvcg\win64\lib\opencv_video470.lib" "$matlabdir\extern\lib\win64\microsoft\libmwoptimizePoses.lib"

# Build Rules
rule cc
    command = $cc $cflags $in /Fo$out

rule cxx
    command = $cxx $cxxflags $in /Fo$out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

